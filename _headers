# Cloudflare Pages security headers
# Applied to every response served by Cloudflare Pages

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://lh3.googleusercontent.com; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://api.cloudinary.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Cache-Control: no-store

# Cache static assets aggressively (logos, icons, fonts)
/logo.png
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=31536000, immutable

/logo-watermark-hero.png
  Cache-Control: public, max-age=31536000, immutable

/logo-watermark-soft.png
  Cache-Control: public, max-age=31536000, immutable

# Never cache config.js or security.js (they may be regenerated)
/config.js
  Cache-Control: no-store, no-cache, must-revalidate

/security.js
  Cache-Control: no-store, no-cache, must-revalidate
